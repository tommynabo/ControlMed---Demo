# ========================================
# 🔑 Configuración de Supabase
# ========================================
# Copia este archivo a .env.local y completa los valores
# Este archivo NO debe ser versionado (está en .gitignore)

# Tu URL de Supabase (encuentra en Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Tu Anon Key (encuentra en Supabase Dashboard -> Settings -> API)
# Esta es la clave pública, segura para usar en el frontend
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Opcional) Service Role Key - solo para scripts del backend
# NO incluir en .env.local, usar solo en .env local de backend
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================================
# 📋 Instrucciones Paso a Paso
# ========================================
# 1. Abre https://supabase.com y loguéate
# 2. Abre tu proyecto "MediCore"
# 3. Ve a Settings <- API (abajo a la izquierda)
# 4. Copia:
#    - "Project URL" → VITE_SUPABASE_URL
#    - "anon public" key → VITE_SUPABASE_ANON_KEY
# 5. Guarda este archivo como .env.local en la raíz del proyecto
# 6. Reinicia el servidor (npm run dev)

# ========================================
# 🧪 Para Desarrollo Local
# ========================================
# Si usas Supabase localmente con Docker:
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24ifQ.625_WdcF3KHqz5amU0x2X5WWHP-OEs_4juPDNYM8mEI
