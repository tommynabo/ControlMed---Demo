generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  RECEPTION
  DOCTOR
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String
  name      String
  role      Role        @default(DOCTOR)
  isActive  Boolean     @default(true)
  doctorId  String?
  doctor    Doctor?     @relation(fields: [doctorId], references: [id])
  createdAt DateTime    @default(now())
  workShifts WorkShift[]
  prescriptions Prescription[]
}

model Prescription {
  id                      String   @id @default(uuid())
  patient                 Patient  @relation(fields: [patientId], references: [id])
  patientId               String
  doctor                  User     @relation(fields: [doctorId], references: [id])
  doctorId                String
  medication              String
  pharmaceuticalForm      String?
  administrationRoute     String?
  packagesNumber          Int?
  dose                    String?
  duration                String?
  posology                String?
  units                   String?
  schedulePattern         String?  // Pauta
  prescriptionDate        DateTime @default(now())
  dispensationDate        DateTime?
  dispensationOrderNumber String?
  diagnosis               String?
  patientInstructions     String?
  pharmacyInstructions    String?
  createdAt               DateTime @default(now())

  @@index([patientId])
  @@index([doctorId])
}

model WorkShift {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  clockIn      DateTime @default(now())
  clockOut     DateTime?
  breakMinutes Int      @default(0)
  notes        String?
  isManual     Boolean  @default(false)
  date         String   // Storing as YYYY-MM-DD for easier daily filtering
  createdAt    DateTime @default(now())
}

model Patient {
  id              String           @id @default(uuid())
  historyNumber   String?          @unique
  name            String
  firstName       String?
  lastName1       String?
  lastName2       String?
  dni             String           @unique
  birthDate       DateTime
  email           String
  phone           String?
  insurance       String?
  assignedDoctorId String?
  doctor          Doctor?          @relation(fields: [assignedDoctorId], references: [id])
  clinicalHistory ClinicalRecord[]
  invoices        Invoice[]
  appointments    Appointment[]
  treatmentPlans  TreatmentPlan[]
  budgets         Budget[]
  odontogram      Odontogram?
  snapshots       DentalSnapshot[]
  balance         Float            @default(0.0)
  wallet          Float            @default(0.0)
  allergies       String?
  smoker          Boolean          @default(false)
  diseases        String?
  medications     String?
  criticalAlerts  String?
  prescriptions   Prescription[]
  medicalHistory  String?
  createdAt       DateTime         @default(now())
  payments        Payment[]
  whatsAppLogs    WhatsAppLog[]
  consents        Consent[]
}

model Consent {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  templateId  String
  title       String
  isSigned    Boolean   @default(false)
  signedDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([patientId])
}

model Specialty {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  doctors     Doctor[]
  treatments  Treatment[]
}

model Doctor {
  id                   String           @id @default(uuid())
  name                 String
  specialization       String?
  specialtyId          String?
  specialty            Specialty?       @relation(fields: [specialtyId], references: [id])
  commissionPercentage Float            @default(0.0)
  users                User[]
  patients             Patient[]
  appointments         Appointment[]
  liquidations         Liquidation[]
  schedules            DoctorSchedule[]
}

model DoctorSchedule {
  id             String   @id @default(uuid())
  doctorId       String   @map("doctor_id")
  doctor         Doctor   @relation(fields: [doctorId], references: [id])
  doctorName     String?  @map("doctor_name")
  monday         Boolean  @default(true)
  tuesday        Boolean  @default(true)
  wednesday      Boolean  @default(true)
  thursday       Boolean  @default(true)
  friday         Boolean  @default(true)
  saturday       Boolean  @default(false)
  sunday         Boolean  @default(false)
  morningStart   String?  @map("morning_start")
  morningEnd     String?  @map("morning_end")
  afternoonStart String?  @map("afternoon_start")
  afternoonEnd   String?  @map("afternoon_end")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("doctor_schedules")
}

model Treatment {
  id              String           @id @default(uuid())
  name            String
  price           Float
  labCost         Float            @default(0.0)
  insurancePrices String?
  specialtyId     String?
  specialty       Specialty?       @relation(fields: [specialtyId], references: [id])
  appointments    Appointment[]
  items           InvoiceItem[]
  budgetItems     BudgetLineItem[]
  consumables     String?
}

model PatientTreatment {
  id          String   @id @default(uuid())
  patientId   String
  serviceId   String?
  serviceName String
  toothId     Int?
  price       Float    @default(0.0)
  customPrice Float?
  status      String   @default("PENDIENTE")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([patientId])
  @@index([serviceId])
}

model Service {
  id              String    @id @default(uuid())
  name            String
  specialty_name  String?
  specialty_color String?   @default("#888888")
  final_price     Float?    @default(0)
  is_active       Boolean?  @default(true)
  created_at      DateTime? @default(now())
  updated_at      DateTime? @default(now()) @updatedAt
}

model Appointment {
  id           String    @id @default(uuid())
  date         DateTime
  time         String
  duration     Int       @default(60)
  observations String?
  visitDetails String?
  status       String    @default("Scheduled")
  paid         Boolean   @default(false)
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  doctorId     String
  doctor       Doctor    @relation(fields: [doctorId], references: [id])
  treatmentId   String?
  treatment     Treatment? @relation(fields: [treatmentId], references: [id])
  treatmentName String?
  budgetId     String?
  budget       Budget?   @relation(fields: [budgetId], references: [id])
  budgetItemId String?
  amount       Float?
  liquidation Liquidation?
  invoice     Invoice?
  whatsappSent Boolean   @default(false) @map("whatsapp_sent")
}

model Liquidation {
  id              String      @id @default(uuid())
  doctorId        String
  doctor          Doctor      @relation(fields: [doctorId], references: [id])
  appointmentId   String?     @unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  grossAmount     Float
  labCost         Float
  commissionRate  Float
  finalAmount     Float
  treatmentName   String?
  patientName     String?
  paymentMethod   String?
  status          String      @default("PENDING")
  doctorInvoiceUrl String?
  paidDate        DateTime?
  createdAt       DateTime    @default(now())
}

model Payment {
  id               String   @id @default(uuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
  budgetId         String?
  amount           Float
  method           String
  type             String
  paymentBreakdown String?
  doctorId         String?
  sourcePaymentId  String?
  treatmentId      String?
  createdAt        DateTime @default(now())
  invoiceId        String?  @unique
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  notes            String?

  @@index([patientId])
}

model Invoice {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique
  patientId        String
  patient          Patient       @relation(fields: [patientId], references: [id])
  amount           Float
  date             DateTime      @default(now())
  status           String
  paymentMethod    String?
  url              String?
  externalId       String?
  items            InvoiceItem[]
  concept          String?
  appointmentId    String?       @unique
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id])
  relatedPaymentId String?       @unique
  relatedPayment   Payment?
}

model InvoiceItem {
  id        String     @id @default(uuid())
  invoiceId String
  invoice   Invoice    @relation(fields: [invoiceId], references: [id])
  serviceId String?
  service   Treatment? @relation(fields: [serviceId], references: [id])
  name      String
  price     Float
}

model TreatmentPlan {
  id          String        @id @default(uuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id])
  name        String
  totalCost   Float
  startDate   DateTime
  duration    Int
  installments Installment[]
  status      String        @default("ACTIVE")
}

model Installment {
  id           String        @id @default(uuid())
  planId       String
  plan         TreatmentPlan @relation(fields: [planId], references: [id])
  dueDate      DateTime
  amount       Float
  status       String        @default("PENDING")
  paidDate     DateTime?
  description  String
  invoiceId    String?
  invoicedAt   DateTime?
  reminderSent Boolean       @default(false)
}

model Budget {
  id           String           @id @default(uuid())
  patientId    String
  title        String?
  patient      Patient          @relation(fields: [patientId], references: [id])
  date         DateTime         @default(now())
  status       String           @default("DRAFT")
  totalAmount  Float            @default(0.0)
  items        BudgetLineItem[]
  appointments Appointment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model BudgetLineItem {
  id          String     @id @default(uuid())
  budgetId    String
  budget      Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  treatmentId String?
  treatment   Treatment? @relation(fields: [treatmentId], references: [id])
  name        String
  price       Float
  quantity    Int        @default(1)
  tooth       String?
  face        String?
}

model ClinicalRecord {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  date      DateTime @default(now())
  text      String
  authorId  String?
}

model InventoryItem {
  id       String @id @default(uuid())
  name     String
  category String
  quantity Int
  minStock Int
  unit     String
}

model DocumentTemplate {
  id        String   @id @default(uuid())
  title     String
  category  String   @default("General")
  content   String
  type      String
  size      String
  createdAt DateTime @default(now())
}

model Odontogram {
  id        String   @id @default(uuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id])
  teethState String
  updatedAt  DateTime @updatedAt
}

model DentalSnapshot {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  date        DateTime @default(now())
  imageUrl    String
  description String?
}

enum WhatsAppLogStatus {
  SENT
  FAILED
  PENDING
}

enum WhatsAppTriggerType {
  APPOINTMENT_REMINDER
  TREATMENT_FOLLOWUP
  BIRTHDAY
}

model WhatsAppTemplate {
  id            String              @id @default(uuid())
  name          String
  content       String
  triggerType   WhatsAppTriggerType
  triggerOffset String
  createdAt     DateTime            @default(now())
}

model WhatsAppLog {
  id           String              @id @default(uuid())
  patientId    String
  patient      Patient             @relation(fields: [patientId], references: [id])
  type         WhatsAppTriggerType
  status       WhatsAppLogStatus   @default(PENDING)
  content      String
  error        String?
  sentAt       DateTime            @default(now())
  scheduledFor DateTime?
}

model ClinicalTreatmentPlan {
  id        String                  @id @default(uuid())
  patientId String?
  name      String                  @default("Plan de Tratamiento")
  status    String                  @default("ACTIVE")
  notes     String?
  steps     ClinicalTreatmentStep[]
  createdAt DateTime                @default(now())
  updatedAt DateTime?               @updatedAt

  @@map("clinical_treatment_plans")
  @@index([patientId])
}

model ClinicalTreatmentStep {
  id            String                @id @default(uuid())
  planId        String?
  plan          ClinicalTreatmentPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  stepOrder     Int                   @default(0)
  treatmentName String?
  toothId       Int?
  status        String                @default("PENDIENTE")
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())

  @@map("clinical_treatment_steps")
  @@index([planId])
}

model AgendaClosure {
  id        String   @id @default(uuid())
  date      DateTime @map("closure_date") @db.Date
  doctorId  String?  @map("doctor_id")
  reason    String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("agenda_closures")
  @@index([date])
}
